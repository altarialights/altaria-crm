---
import { UserButton } from '@clerk/astro/components';
import Sidebar from '../components/Sidebar';
import SidebarToggle from '../components/SidebarToggle';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;

// The drawer toggle only needs JS below `lg`; the sidebar also has desktop flyouts.
const DRAWER_MEDIA = '(width < 64rem)';
---

<BaseLayout title={`${title} · Altaria CRM`}>
	<Sidebar client:load currentPath={Astro.url.pathname}>
		{/* Astro component passed as a slot: React renders it as static HTML and never touches it */}
		<UserButton />
	</Sidebar>
	<div class="lg:pl-64">
		{/* Mobile only: from `lg` up the brand and the user menu live in the sidebar */}
		<header class="border-b border-ink-200 bg-white lg:hidden">
			<div class="flex h-14 items-center gap-3 px-4">
				<SidebarToggle client:media={DRAWER_MEDIA} />
				<a href="/" class="font-semibold tracking-tight">Altaria CRM</a>
			</div>
		</header>
		<main class="px-4 py-8 lg:px-6">
			<slot />
		</main>
	</div>
</BaseLayout>
