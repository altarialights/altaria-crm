# Copy to .env for `astro dev` (never commit .env).
# In production, set each one in Vercel → Project → Settings → Environment Variables.

# Clerk Dashboard → API keys (same Clerk instance as the API)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Use the deployed API when running only the web app locally.
PUBLIC_API_URL=https://altaria-crm.altarialights.workers.dev
# To develop both apps locally with `pnpm dev`, use this instead:
# PUBLIC_API_URL=http://localhost:8787
