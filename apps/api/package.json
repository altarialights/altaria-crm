{
  "name": "@altaria/api",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "node --env-file-if-exists=.dev.vars scripts/migrate.js",
    "test:db": "node --test scripts/migrate.test.js",
    "test:gallery": "tsx --test scripts/gallery.test.js",
    "test:cards": "tsx --test scripts/cards.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.1"
  }
}
